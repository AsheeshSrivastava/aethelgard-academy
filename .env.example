# Local LMS Platform Environment Configuration
# Copy this file to .env (which is strictly git-ignored) and fill in your values.

# Set to "false" to connect to your local Unsloth Studio / local model
MOCK_AI=false

# Unsloth Studio default endpoint
LOCAL_LLM_BASE_URL=http://127.0.0.1:8888/v1
LOCAL_LLM_MODEL=auto

# Unsloth Studio local API Key (from Unsloth: ... More -> Settings -> API)
# Paste your token below:
UNSLOTH_STUDIO_AUTH_TOKEN=
